{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"packageRules": [
		{
			"matchDatasources": [
				"docker"
			],
			"automerge": true,
      "automergeType": "branch",
			"matchUpdateTypes": [
				"digest"
			],
			"group": {
				"branchTopic": "{{{groupSlug}}}-docker-digest"
			},
			"ignoreTests": true
		}
	]
}
